{
  "_comment": "C# -> Java mapping for the transpiler. Used by transpile_ast.py to rewrite IL2CPP decompiled .c into idiomatic Java. Keys/values are kept deliberately flat for easy diffing.",

  "primitives": {
    "System.Void": "void",
    "System.Boolean": "boolean",
    "System.Byte": "byte",
    "System.SByte": "byte",
    "System.Char": "char",
    "System.Int16": "short",
    "System.UInt16": "short",
    "System.Int32": "int",
    "System.UInt32": "int",
    "System.Int64": "long",
    "System.UInt64": "long",
    "System.IntPtr": "long",
    "System.UIntPtr": "long",
    "System.Single": "float",
    "System.Double": "double",
    "System.String": "String",
    "System.Object": "Object",
    "System.Type": "Class<?>",
    "System.Exception": "RuntimeException"
  },

  "_comment_collections": "Generic collections: the <T> form is handled separately; these entries are for the raw/outer type name lookup.",

  "collections": {
    "System.Collections.Generic.List":                 "java.util.ArrayList",
    "System.Collections.Generic.IList":                "java.util.List",
    "System.Collections.Generic.IReadOnlyList":        "java.util.List",
    "System.Collections.Generic.IEnumerable":          "java.lang.Iterable",
    "System.Collections.Generic.IEnumerator":          "java.util.Iterator",
    "System.Collections.Generic.Dictionary":           "java.util.HashMap",
    "System.Collections.Generic.IDictionary":          "java.util.Map",
    "System.Collections.Generic.IReadOnlyDictionary":  "java.util.Map",
    "System.Collections.Generic.SortedDictionary":     "java.util.TreeMap",
    "System.Collections.Generic.HashSet":              "java.util.HashSet",
    "System.Collections.Generic.ISet":                 "java.util.Set",
    "System.Collections.Generic.Queue":                "java.util.ArrayDeque",
    "System.Collections.Generic.Stack":                "java.util.ArrayDeque",
    "System.Collections.Generic.KeyValuePair":         "java.util.Map.Entry",
    "System.Collections.ArrayList":                    "java.util.ArrayList"
  },

  "_comment_collection_methods": "Method-level mapping. Key = C# member name on a List/Dict/etc., value = Java equivalent. For get_X/set_X properties, we strip the prefix and use the property name.",

  "collection_methods": {
    "List.Add":             "add",
    "List.AddRange":        "addAll",
    "List.Clear":           "clear",
    "List.Contains":        "contains",
    "List.IndexOf":         "indexOf",
    "List.Insert":          "add",
    "List.Remove":          "remove",
    "List.RemoveAt":        "remove",
    "List.Sort":            "sort",
    "List.ToArray":         "toArray",
    "List.get_Count":       "size",
    "List.get_Item":        "get",
    "List.set_Item":        "set",

    "IList.get_Item":       "get",
    "IList.set_Item":       "set",
    "IList.get_Count":      "size",

    "IReadOnlyList.get_Count": "size",
    "IReadOnlyList.get_Item": "get",

    "IEnumerable.GetEnumerator": "iterator",
    "IEnumerator.MoveNext":      "hasNext",
    "IEnumerator.get_Current":   "next",
    "IEnumerator.Reset":         "/* IEnumerator.Reset has no Java equivalent */",
    "IEnumerator.Dispose":       "/* IEnumerator.Dispose has no Java equivalent */",

    "Dictionary.Add":             "put",
    "Dictionary.Remove":          "remove",
    "Dictionary.Clear":           "clear",
    "Dictionary.ContainsKey":     "containsKey",
    "Dictionary.ContainsValue":   "containsValue",
    "Dictionary.TryGetValue":     "get",
    "Dictionary.get_Count":       "size",
    "Dictionary.get_Item":        "get",
    "Dictionary.set_Item":        "put",
    "Dictionary.get_Keys":        "keySet",
    "Dictionary.get_Values":      "values",

    "HashSet.Add":         "add",
    "HashSet.Remove":      "remove",
    "HashSet.Contains":    "contains",
    "HashSet.Clear":       "clear",
    "HashSet.get_Count":   "size",

    "Queue.Enqueue":       "offer",
    "Queue.Dequeue":       "poll",
    "Queue.Peek":          "peek",
    "Queue.get_Count":     "size",

    "Stack.Push":          "push",
    "Stack.Pop":           "pop",
    "Stack.Peek":          "peek",
    "Stack.get_Count":     "size"
