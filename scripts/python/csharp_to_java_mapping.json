  "_comment_namespaces": "Prefix-based namespace mapping: C# dotted path -> Java dotted package (lowercased). Any subsequent identifier after the matched prefix is kept as-is (class names), except PascalCase methods -> camelCase when we detect a method context.",

  "namespaces": {
    "IdunBattle.":               "tacticus.idunbattle.",
    "IdunBattleLogic.":          "tacticus.idunbattlelogic.",
