  "_comment_system_methods": "Direct method-name translations for System.* APIs used heavily in the game.",

  "system_methods": {
    "System.Math.Min":       "Math.min",
    "System.Math.Max":       "Math.max",
    "System.Math.Abs":       "Math.abs",
    "System.Math.Floor":     "Math.floor",
    "System.Math.Ceiling":   "Math.ceil",
    "System.Math.Round":     "Math.round",
    "System.Math.Sqrt":      "Math.sqrt",
    "System.Math.Pow":       "Math.pow",
    "System.String.IsNullOrEmpty": "java.util.Objects.toString(x, \"\").isEmpty()",
    "System.String.Concat":  "String.join",
    "System.String.Format":  "String.format",
    "System.Object.ReferenceEquals": "==",
    "System.Array.Empty":    "new Object[0]"
  },

  "_comment_il2cpp_runtime": "IL2CPP runtime helpers that appear in Ghidra output. These are either elided or translated to Java idioms.",

  "il2cpp_runtime": {
    "il2cpp_runtime_class_init":        "/* elided: runtime type init */",
    "il2cpp_codegen_object_new":        "new",
    "il2cpp_object_new_checked":        "new",
    "il2cpp_codegen_raise_execution_engine_exception": "throw new RuntimeException",
    "il2cpp_codegen_raise_null_reference": "throw new NullPointerException",
    "il2cpp_codegen_raise_divide_by_zero_exception": "throw new ArithmeticException(\"div by zero\")",
    "il2cpp_codegen_array_bounds_check": "/* elided: JVM does bounds check */",
    "il2cpp_codegen_no_return":         "throw new AssertionError(\"unreachable\")",
    "il2cpp_resolve_interface_method":  "/* elided: direct interface dispatch in JVM */",
    "il2cpp_raise_null_reference":      "throw new NullPointerException",
    "il2cpp_value_box":                 "/* elided: autoboxing */",
    "il2cpp_value_unbox":               "/* elided: autounboxing */",
    "memmove":                          "/* elided: struct copy */",
    "memcpy":                           "/* elided: struct copy */"
  },

